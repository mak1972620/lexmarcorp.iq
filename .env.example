# TANAKA LEGAL IQ - Configuration Environment Variables

# --- GEMINI AI ---
# Gemini API Key for document analysis and legal auditing.
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_api_key_here"

# --- SECURITY ---
# Secret key used for signing JWT tokens. Change this to a long random string.
JWT_SECRET="tanaka-legal-secret-key-2026"

# --- SERVER ---
# The URL where the application is hosted (e.g., http://localhost:3000)
APP_URL="http://localhost:3000"
PORT=3000

# --- PAYMENTS (STRIPE) ---
# Stripe Secret Key for processing payments.
# Get yours at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""

# --- DATABASE ---
# Path to the SQLite database file.
# For local development, 'legal.db' is fine.
DATABASE_PATH="legal.db"
